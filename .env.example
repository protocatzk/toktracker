# ============================================================================
# 0. DOMAIN & AUTOMATISCHES SSL (LET'S ENCRYPT / NGINX PROXY)
# ============================================================================
DOMAIN_NAME=tracker.deinedomain.de
SSL_EMAIL=admin@deinedomain.de

# ============================================================================
# 1. TIKTOKLIVE SESSION & SIGNING SECRETS
# ============================================================================
TIKTOK_SESSION_ID=your_tiktok_sessionid_here
TIKTOK_TARGET_IDC=eu-ttp2
TIKTOK_SIGN_API_KEY=
TIKTOK_WEB_PROXY=
# Leer = WebSocket nutzt automatisch TIKTOK_WEB_PROXY als Fallback.
TIKTOK_WS_PROXY=

# Reconnect-/Stall-Härtung des Ingest-Workers
# Nach dieser Zeit ohne WebSocket-Frame gilt die Verbindung als "stalled" und wird neu aufgebaut.
TIKTOK_STALL_TIMEOUT_SECONDS=120
TIKTOK_RECONNECT_BASE_SECONDS=5
TIKTOK_RECONNECT_MAX_SECONDS=120
# Jitter-Anteil (0.25 = +/-25%) gegen synchronisierte Reconnect-Stürme.
TIKTOK_RECONNECT_JITTER=0.25
# Erst nach dieser stabilen Verbindungsdauer wird der Fehlerzähler zurückgesetzt.
TIKTOK_STABLE_RESET_SECONDS=60
TIKTOK_WS_PING_INTERVAL=20
TIKTOK_WS_PING_TIMEOUT=20
# Globaler Cooldown nach einem Sign-API-429 (Sekunden, Minimum).
TIKTOK_SIGN_COOLDOWN_SECONDS=60
# Gift-Katalog pro Prozess cachen (Sekunden). 21600 = 6 Stunden.
TIKTOK_GIFT_CACHE_TTL_SECONDS=21600
# Kurze TikTok-Aussetzer beenden die Stream-Session erst nach dieser Grace-Period.
TIKTOK_SESSION_GRACE_SECONDS=90
# Live-Alert erst, wenn der Streamer mindestens so viele Minuten offline war.
# Verhindert Alert-Spam bei kurzen Stream-Neustarts/Reconnects.
LIVE_ALERT_MIN_OFFLINE_MINUTES=30

# ============================================================================
# 2. DATENBANK (SQLITE LOKAL ODER EXTERNER MYSQL / MARIADB SERVER)
# ============================================================================
# "sqlite" (lokale Datei tiktok_earnings.db) oder "mysql" (externer MySQL/MariaDB Server)
DB_ENGINE=mysql

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=toktracker
MYSQL_USER=toktracker_user
MYSQL_PASSWORD=user_change_me_in_production
MYSQL_ROOT_PASSWORD=root_change_me_in_production

# Optional als Connection-URL:
# DATABASE_URL=mysql://user:password@host:3306/toktracker

# ============================================================================
# 3. BACKEND & API-SICHERHEIT
# ============================================================================
TIKTOK_API_KEY=change_me_in_production
APP_HOST=0.0.0.0
APP_PORT=5000
# Optionaler URL-Prefix hinter einem Reverse-Proxy (z.B. /track).
# Leer lassen für Betrieb unter "/". Der Proxy muss X-Forwarded-Prefix senden.
APP_BASE_PATH=
# Interne Basis-URL für Service-zu-Service-Aufrufe (z.B. Bot -> App).
# In Docker: http://app:5000. Leer lassen = Bot nutzt den DB-Fallback.
INTERNAL_API_URL=

# --- Session-Signierung -------------------------------------------------------
# Pflicht ab 32 Zeichen. Erzeugen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Ohne Wert wird das Secret aus BOT_TOKEN + API_KEY abgeleitet (mit Warnung),
# ohne diese Quellen ein zufälliges Laufzeit-Secret erzeugt (Sessions überleben
# dann keinen Neustart).
SESSION_SECRET=

# Notfall-Login (optional, nur fuer den Fall, dass Telegram nicht erreichbar ist)
ADMIN_PASSWORD=

# --- Zugriffssperre -----------------------------------------------------------
# whitelist = nur per Telegram freigeschaltete Nutzer (oder API-Key) kommen an die
#             App; alle anderen werden auf /login umgeleitet. Sessions: 24h.
# off       = oeffentlicher Betrieb wie zuvor (Sessions: 7 Tage).
ACCESS_GATE=whitelist

# Öffentliche Infoseite/Startseite unter "/" (unabhängig von der Rolle sichtbar).
# 1 = Landingpage, 0 = "/" zeigt wieder das öffentliche Live-Panel.
LANDING_PAGE_ENABLED=1

# --- Sicherheits-Haertung (optional) ------------------------------------------
# Secure-Flag des Admin-Cookies: auto (nur bei HTTPS) | 1 | 0
SESSION_COOKIE_SECURE=auto
# X-Forwarded-For/X-Real-IP nur hinter einem vertrauenswuerdigen Reverse-Proxy aktivieren
TRUST_PROXY_HEADERS=1
# API-Key zusaetzlich als Query-Parameter (?api_key=...) erlauben (0 = nur Header)
ALLOW_API_KEY_QUERY=1
# FastAPI /docs, /redoc und /openapi.json freischalten (0 = deaktiviert)
ENABLE_API_DOCS=0

# --- Docker-Monitoring --------------------------------------------------------
# Der Web-Container fragt Container-/Volume-Metriken über den mitgelieferten
# docker-socket-proxy ab (nur lesende Endpunkte). Leer = kein Docker-Monitoring.
DOCKER_PROXY_URL=http://docker-socket-proxy:2375

# ============================================================================
# 4. TELEGRAM BOT KONFIGURATION & ZUGRIFFSSCHUTZ
# ============================================================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890
# whitelist = nur freigeschaltete Rollen; public = jeder Telegram-Nutzer erhaelt die Rolle "viewer"
# (Radar/Chat-Intelligence bleiben trotzdem Whitelist-exklusiv).
TELEGRAM_ACCESS_MODE=whitelist
TELEGRAM_ALLOWED_USERS=123456789,@my_telegram_username
# Mini-App ist eingefroren (Legacy). 0 = /miniapp, /app, /webapp leiten auf /public um
# und alle UI-/Bot-Einstiege werden ausgeblendet. 1 = Mini-App wieder aktivieren.
MINIAPP_ENABLED=0
# Optional: externe WebApp-/Web-Panel-URL für Telegram-Buttons (Legacy).
# TELEGRAM_WEBAPP_URL=https://tracker.deinedomain.de/track/public
