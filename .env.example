# ============================================================================
# 0. DOMAIN & AUTOMATISCHES SSL (LET'S ENCRYPT / NGINX PROXY)
# ============================================================================
DOMAIN_NAME=tracker.deinedomain.de
SSL_EMAIL=admin@deinedomain.de

# ============================================================================
# 1. TIKTOKLIVE SESSION & SIGNING SECRETS
# ============================================================================
TIKTOK_SESSION_ID=your_tiktok_sessionid_here
TIKTOK_TARGET_IDC=eu-ttp2
TIKTOK_SIGN_API_KEY=
TIKTOK_WEB_PROXY=
TIKTOK_WS_PROXY=

# ============================================================================
# 2. DATENBANK (SQLITE LOKAL ODER EXTERNER MYSQL / MARIADB SERVER)
# ============================================================================
# "sqlite" (lokale Datei tiktok_earnings.db) oder "mysql" (externer MySQL/MariaDB Server)
DB_ENGINE=mysql

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=toktracker
MYSQL_USER=toktracker_user
MYSQL_PASSWORD=user_change_me_in_production
MYSQL_ROOT_PASSWORD=root_change_me_in_production

# Optional als Connection-URL:
# DATABASE_URL=mysql://user:password@host:3306/toktracker

# ============================================================================
# 3. BACKEND & API-SICHERHEIT
# ============================================================================
TIKTOK_API_KEY=change_me_in_production
APP_HOST=0.0.0.0
APP_PORT=5000

# ============================================================================
# 4. TELEGRAM BOT KONFIGURATION & ZUGRIFFSSCHUTZ
# ============================================================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_ACCESS_MODE=whitelist
TELEGRAM_ALLOWED_USERS=123456789,@my_telegram_username
