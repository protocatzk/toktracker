# ============================================================================
# 1. TIKTOKLIVE SESSION & SIGNING SECRETS
# ============================================================================
# Deine TikTok Cookie "sessionid" (Browser-DevTools -> Application -> Cookies -> tiktok.com)
TIKTOK_SESSION_ID=your_tiktok_sessionid_here

# Rechenzentrums-Cookie "tt-target-idc" (z.B. eu-ttp2, useast2a)
TIKTOK_TARGET_IDC=eu-ttp2

# Optionaler EulerStream Sign-API-Key (https://www.eulerstream.com)
TIKTOK_SIGN_API_KEY=

# Optionale Proxies (z.B. http://user:pass@host:port)
TIKTOK_WEB_PROXY=
TIKTOK_WS_PROXY=

# ============================================================================
# 2. BACKEND & API-SICHERHEIT
# ============================================================================
TIKTOK_API_KEY=change_me_in_production
APP_HOST=0.0.0.0
APP_PORT=5000

# ============================================================================
# 3. TELEGRAM BOT KONFIGURATION
# ============================================================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890
